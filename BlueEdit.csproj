<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>be</AssemblyName>
    <Version>0.4.1</Version>
    <RootNamespace>BlueEdit</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>CA1416</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
    <Compile Remove="publish\**" />
    <!-- the editor's own code is src\BlueEdit; the other folders of src are projects of their own -->
    <Compile Remove="src\Tui\**" />
    <Compile Remove="src\MathImages\**" />
    <Compile Remove="tools\**" />
    <InternalsVisibleTo Include="BlueEdit.Tests" />
    <!-- Chrome's model without Chrome: written next to its virtual environment when used (ChromeModelChecker) -->
    <EmbeddedResource Include="tools\chrome-model\proofread.py" LogicalName="proofread.py" />
    <!-- fastText's language identification model (CC BY-SA 3.0, models/README.md): the language of a paragraph -->
    <EmbeddedResource Include="models\lid.176.ftz" LogicalName="lid.176.ftz" />
    <!-- the interface in other languages (Ui.cs): English string -> translation, one table per language -->
    <EmbeddedResource Include="lang\*.json" LogicalName="lang.%(Filename).json" />
    <!-- the F1 help, English and other languages (HelpText.cs); without WithCulture="false" the ".ru." in the name would send it
         into a satellite assembly (ru\be.resources.dll), which a single-file be.exe does not look in -->
    <EmbeddedResource Include="lang\help.*.txt" LogicalName="lang.%(Filename).txt" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src\Tui\Tui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WeCantSpell.Hunspell" Version="7.0.1" />
  </ItemGroup>

</Project>
