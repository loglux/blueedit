<Project Sdk="Microsoft.NET.Sdk">

  <!-- A tiny app on the Tui layer: shows every input event it receives. Used by the UI tests to check the
       terminal layer in a real console (key decoding, mouse, paste, resize) and to measure latency. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>CA1416</NoWarn>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tui\Tui.csproj" />
  </ItemGroup>

</Project>
